            </column>
            <column caption='CY casualties' datatype='integer' name='[Calculation_1514053952262184965]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF  YEAR([Accident Date])= [Parameters].[Parameter 1]&#13;&#10;THEN [Number_of_Casualties] &#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='Accident Severity Filter' datatype='boolean' name='[Calculation_431782666916978688]' role='dimension' type='nominal'>
